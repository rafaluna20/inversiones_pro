// Reglas PERMISIVAS solo para el emulador local usado en tests de
// integración (ver __tests__/integration/ y `npm run test:emulator`).
// NO es el archivo que se despliega — ese es firestore.rules. Este archivo
// existe para que los tests de integración prueben la ATOMICIDAD real de
// las runTransaction sin acoplarse también a las reglas de seguridad
// (eso ya se prueba/revisa por separado).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
