# ====================================
# CONFIGURACIÓN DE SEGURIDAD
# ====================================
#
# lib/security/encryption.ts y lib/security/rate-limiter.ts (Redis) se
# eliminaron: estaban completos pero nunca conectados a ningún flujo real de
# la app, y el README afirmaba características que no existían. El rate
# limiting real hoy es lib/security/edge-rate-limit.ts (en memoria, por
# instancia — ver su propio comentario sobre esa limitación). Si se necesita
# cifrado de campos sensibles o rate limiting distribuido más adelante, hay
# que reconstruirlos conectados desde el principio, no como módulos aparte.

# FIREBASE
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# BILLETERA DIGITAL (wallet_digital) — puente con el banco
# NEXT_PUBLIC_WALLET_API_URL / NEXT_PUBLIC_ODOO_DB: el mismo Odoo que usa el resto del ecosistema (control-app,
# billetera_wallet, akallpa_inversionistas). El login del inversionista (app/actions/auth.ts) sigue siendo con su
# correo y su contraseña de la billetera: eso no cambia.
NEXT_PUBLIC_WALLET_API_URL=http://localhost:8069
NEXT_PUBLIC_ODOO_DB=odoo_db

# Para PAGAR (plataforma → billetera del usuario, al retirar): esta app firma la petición con su PROPIO secreto, ya
# que el banco no acepta que el destino de un pago lo declare quien llama sin firmar (ver lib/wallet-signature.ts).
# El código debe coincidir con el que se creó en el banco (Wallet Digital → Configuración → Plataformas →
# «Inversiones Pro», code=inversiones_pro) y el secreto es el «Secreto de firma» que se ve ahí (solo se muestra una
# vez al crear la plataforma o al «Regenerar secreto»). Son variables de SERVIDOR: nunca con prefijo NEXT_PUBLIC_.
WALLET_PLATFORM_CODE=inversiones_pro
WALLET_PLATFORM_SECRET=pegar-aqui-el-secreto-de-la-plataforma-en-el-banco

# JWT para autenticación
JWT_SECRET=genera-un-secreto-jwt-aqui
JWT_EXPIRES_IN=7d

# ENTORNO
NODE_ENV=development

# ====================================
# CONFIGURACIÓN OPCIONAL - FASE 2
# ====================================

# Sentry (APM/Error Tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Cloud Logging
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Webhooks para notificaciones
# Usados por lib/resilience/reconciliation.ts para alertar cuando el job de
# reconciliación Odoo-Firebase encuentra problemas críticos.
# WEBHOOK_SLACK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# WEBHOOK_DISCORD=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Firebase Admin SDK (lib/firebase/admin.ts)
# REQUERIDO en producción: lo usan TODAS las Server Actions de dinero (invertir,
# liquidar, cargar/retirar saldo, transferir) además de los scripts de servidor
# (scripts/ejecutarReconciliacion.ts). Sin esta variable esas acciones fallan
# con "Servicio no disponible". JSON completo de la service account,
# como string en una sola línea. Generar desde:
# Firebase Console > Configuración del proyecto > Cuentas de servicio >
# Generar nueva clave privada. NUNCA exponer con prefijo NEXT_PUBLIC_.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...",...}

# Modo demo del saldo de la plataforma (SOLO entornos de desarrollo/prueba)
# Con PLATAFORMA_MODO_DEMO=true el SERVIDOR permite: "Añadir saldo demo" sin
# billetera (recargar), el retiro "demo" a banco y "aportar ganancia" al
# liquidar un proyecto (crea saldo sin dinero real). Deja esta variable SIN
# definir (o en false) en producción: si no, cualquier usuario podría
# fabricarse saldo. Es una variable de SERVIDOR: nunca con prefijo NEXT_PUBLIC_.
# PLATAFORMA_MODO_DEMO=true
