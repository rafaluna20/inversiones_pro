// ═══════════════════════════════════════════════════════════════════════
// FIRESTORE SECURITY RULES — LISTAS PARA REVISAR Y DESPLEGAR
// ═══════════════════════════════════════════════════════════════════════
//
// A diferencia de la versión anterior de este archivo (que era una
// inferencia a partir del código), esta se escribió comparando línea por
// línea contra las reglas REALMENTE desplegadas en producción, exportadas
// el 2026-07-20 con `npx tsx scripts/exportarReglasProduccion.ts`
// (ver firestore.rules.PRODUCCION-REAL.txt, gitignorado).
//
// ⚠️ LO QUE HAY DESPLEGADO HOY ES GRAVE: para usuarios, productos,
// inversiones, distribuciones, gastos, y el journal del puente con Odoo
// (plataforma_cargas / plataforma_retiros), la regla real es literalmente
// `allow write: if request.auth != null` — CUALQUIER usuario autenticado
// (una cuenta gratis, autoregistrada) puede escribir el saldo de CUALQUIER
// OTRO usuario, editar el proyecto de otro creador, o reescribir un
// documento de `distribuciones` que se supone es inmutable. No hay ningún
// chequeo de dueño. Esto es explotable ahora mismo.
//
// ─────────────────────────────────────────────────────────────────────
// CAMBIOS RESPECTO A LO DESPLEGADO HOY (resumen para revisar rápido)
// ─────────────────────────────────────────────────────────────────────
// - usuarios: antes CUALQUIERA podía escribir el doc de cualquiera. Ahora
//   solo el propio dueño (o admin) puede escribir el suyo, y ni siquiera
//   el dueño puede tocar roles/permisos/email.
// - productos: la lectura pública se mantiene igual (allow read: if true).
//   La escritura antes era "cualquier autenticado, cualquier proyecto".
//   Ahora: el dueño/gestor tiene edición completa; cualquier otro usuario
//   autenticado solo puede tocar votos/haVotado/comentarios (para no
//   romper votar y comentar, que hoy cualquiera puede hacer).
// - inversiones, distribuciones, plataforma_cargas, plataforma_retiros,
//   gastos: antes "cualquier autenticado, cualquier documento". Ahora,
//   scoped al dueño real o denegado del todo si debe ser server-only.
// - catch-all: antes `if request.auth != null` para CUALQUIER colección no
//   listada explícitamente. Ahora deniega todo por defecto.
//
// ─────────────────────────────────────────────────────────────────────
// ANTES DE DESPLEGAR (`firebase deploy --only firestore:rules`)
// ─────────────────────────────────────────────────────────────────────
//   1. Pegar este archivo en Firebase Console → Firestore Database →
//      Reglas → pestaña "Simulador de reglas" (Rules Playground) y probar
//      ahí primero, sin desplegar, con casos reales: leer/escribir tu
//      propio usuario, intentar escribir el de otro (debe fallar), votar
//      un producto, editar un producto ajeno (debe fallar).
//   2. Probar en la app real, en este orden, apenas despliegues:
//      a. Recargar billetera (Validacion/acreditarDesdeBilletera.ts corre
//         en el cliente — debería seguir funcionando, escribe su propio uid).
//      b. Votar y comentar en un producto (debe seguir funcionando).
//      c. Crear/editar un producto propio (debe seguir funcionando).
//      d. Invertir/eliminar inversión/distribuir/depositar recaudado/liquidar
//         proyecto (ejecutarDistribucionAction) — ya NO dependen de estas
//         reglas (corren con Admin SDK, verificado extremo a extremo contra
//         producción y contra el emulador), así que no deberían verse
//         afectados por este archivo en absoluto.
//      e. ⚠️ Retirar hacia la billetera bancaria (withdrawFromPlatformAction
//         en app/actions/wallet.ts) — YA se migró a Admin SDK (verifica el
//         ID token real antes de tocar Firestore, igual que el resto), pero
//         a diferencia de los demás no se pudo probar de punta a punta con
//         un test automatizado: depende de `cookies()` de next/headers
//         (requiere un request real de Next.js) y de un servidor Odoo
//         externo, ninguno de los dos disponibles en Jest. Probarlo a mano
//         en la app es la única verificación real que existe hoy de este
//         flujo específico.
//
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function myRoles() {
      return signedIn() && ('roles' in userDoc(request.auth.uid))
        ? userDoc(request.auth.uid).roles
        : [];
    }

    function hasRole(role) {
      return signedIn() && role in myRoles();
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }

    // "Gestor" en el sentido amplio usado por la app: admin, o gestor con
    // rol explícito, o dueño del proyecto vía `gestorId`/`creador.id` (ver
    // construirUsuarioRBAC en app/actions/distribucion.ts, que usa la misma
    // combinación de señales).
    function esGestorDelProyecto(proyectoId) {
      let proyecto = get(/databases/$(database)/documents/productos/$(proyectoId)).data;
      return isAdmin() || hasRole('gestor')
        || (signedIn() && 'gestorId' in proyecto && proyecto.gestorId == request.auth.uid)
        || (signedIn() && 'creador' in proyecto && proyecto.creador.id == request.auth.uid);
    }

    function camposNoModificados(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos) == false;
    }

    function soloEstosCampos(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Campos de un PRODUCTO que mueven o determinan dinero: son de solo-servidor
    // (Admin SDK: invertir, liquidar, depositar recaudado). Antes el gestor podia
    // editarlos desde el navegador: bajar `precio` despues de recaudar para pagar
    // menos capital al liquidar, subirse `comisionGestor`, borrar inversores, o
    // volver `depositoRecaudado` a false. `precio` y `comisionGestor` solo se
    // pueden cambiar mientras NO haya inversores (la "regla de oro" de la app).
    function camposMonetariosIntactos() {
      return camposNoModificados([
          'inversores', 'estado', 'monto', 'depositoRecaudado',
          'distribucionEjecutada', 'utilidadNeta', 'fechaDistribucion',
          'creador', 'gestorId'
        ])
        && (resource.data.get('inversores', []).size() == 0
            || camposNoModificados(['precio', 'comisionGestor']));
    }

    // ─────────────────────────────────────────────────────────────────
    // USUARIOS
    // ─────────────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      // LECCIÓN APRENDIDA AL DESPLEGAR: restringir la lectura a "solo el
      // propio dueño" rompió funciones reales que necesitan leer el perfil
      // de OTRO usuario — mostrar el teléfono del creador de un proyecto
      // (Hooks/useCreadorPhone.ts) para contactarlo por WhatsApp, listas de
      // inversores, perfiles públicos (/usuarios/[id], /perfil). Firestore
      // no permite restringir por CAMPO en una regla de lectura (es
      // documento completo o nada), así que la lectura queda abierta a
      // cualquier autenticado — igual que estaba antes de este cambio. Lo
      // que sí se cierra, y es lo que importa, es la ESCRITURA: nadie más
      // que el dueño puede tocar el documento de otro usuario.
      allow read: if signedIn();

      // BUG CRÍTICO CORREGIDO: `request.resource.data.roles` accedía a una
      // clave que crear-cuenta/page.tsx nunca escribe. En el lenguaje de
      // reglas de Firestore, leer una clave inexistente de un mapa hace
      // fallar TODA la expresión (deniega, no la trata como ausente) — esto
      // bloqueó el registro de CUALQUIER usuario nuevo desde que se desplegó
      // por primera vez esta regla. `('roles' in ...)` chequea existencia
      // antes de leer el valor, evitando el error.
      allow create: if isSelf(uid)
        && request.resource.data.saldo == 0
        && request.resource.data.get('saldoRecaudado', []).size() == 0
        && (!('roles' in request.resource.data) || request.resource.data.roles == ['usuario']);

      // El dueño puede actualizar su propio doc, pero NUNCA su saldo ni sus
      // roles/permisos/email. `saldo` y `saldoRecaudado` son de solo-servidor
      // (app/actions/plataforma-saldo.ts, inversion.ts, distribucion.ts, wallet.ts):
      // antes esta regla dejaba al dueño escribir `saldo` porque la recarga se
      // acreditaba desde el navegador, y cualquiera podia fijarse el saldo que
      // quisiera desde la consola y retirarlo a su billetera.
      allow update: if (isSelf(uid) || isAdmin())
        && camposNoModificados(['roles', 'permisosAdicionales', 'permisosRevocados', 'email', 'saldo', 'saldoRecaudado']);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────
    // BOOKMARKS (favoritos) — Hooks/useBookmarks.ts, doc keyed por uid.
    // Colección real que no estaba contemplada en el borrador original:
    // el catch-all denegaba todo, rompiendo "guardar favorito" en producción.
    // ─────────────────────────────────────────────────────────────────
    match /bookmarks/{uid} {
      allow read, write: if isSelf(uid);
    }

    // ─────────────────────────────────────────────────────────────────
    // PRODUCTOS (proyectos de inversión)
    // ─────────────────────────────────────────────────────────────────
    match /productos/{proyectoId} {
      // Igual que hoy: catálogo público, cualquiera puede leer.
      allow read: if true;

      // Un producto nace sin inversores, abierto y sin dinero recaudado: no se
      // puede crear uno "ya liquidado" o con inversores inventados.
      allow create: if signedIn() && request.resource.data.creador.id == request.auth.uid
        && request.resource.data.get('inversores', []).size() == 0
        && request.resource.data.get('estado', true) == true
        && request.resource.data.get('monto', 0) == 0
        && request.resource.data.get('depositoRecaudado', false) == false
        && request.resource.data.get('distribucionEjecutada', false) == false;

      // El dueño/gestor puede editar todo. Cualquier otro usuario
      // autenticado SOLO puede tocar votos/haVotado/comentarios (votar y
      // comentar) — no precio, no inversores, no estado, no nada financiero.
      allow update: if (esGestorDelProyecto(proyectoId) && camposMonetariosIntactos())
        || (signedIn() && soloEstosCampos(['votos', 'haVotado', 'comentarios']));

      allow delete: if esGestorDelProyecto(proyectoId) || isAdmin();

      // GASTOS del proyecto — lib/firebase/gastos.ts guarda esto como
      // SUBCOLECCIÓN (`productos/{proyectoId}/gastos`), no como colección de
      // nivel superior. La regla `match /gastos/{gastoId}` de nivel superior
      // que existía antes NUNCA coincidía con esta ruta real — caía al
      // catch-all y denegaba todo, incluida la lectura del propio gestor de
      // los gastos de su propio proyecto (pestaña "Gastos"/"Admin").
      match /gastos/{gastoId} {
        allow read: if signedIn();
        allow write: if esGestorDelProyecto(proyectoId);
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // INVERSIONES (colección separada del modelo bifásico — hoy sin
    // ninguna pantalla conectada. La única vía de escritura es
    // invertirEnEtapaAction (app/actions/inversion-bifasica.ts), que usa
    // Admin SDK y por lo tanto ignora estas reglas. Por eso create/update
    // se deniegan del todo acá: la versión anterior permitía que CUALQUIER
    // cliente creara un doc con confirmada=false sin que se le debitara un
    // sol — "invertí sin pagar". Solo lectura scoped al dueño/gestor.)
    // ─────────────────────────────────────────────────────────────────
    match /inversiones/{inversionId} {
      allow read: if signedIn() && (resource.data.usuarioId == request.auth.uid
        || esGestorDelProyecto(resource.data.proyectoId));

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────
    match /socios/{socioId} {
      allow read: if signedIn() && (resource.data.usuarioId == request.auth.uid
        || esGestorDelProyecto(resource.data.proyectoId));
      allow write: if esGestorDelProyecto(resource.data.proyectoId)
        || (request.resource.data.proyectoId is string && esGestorDelProyecto(request.resource.data.proyectoId));
    }

    // ─────────────────────────────────────────────────────────────────
    // DISTRIBUCIONES — documento "inmutable" firmado con hash SHA-256.
    // Hoy CUALQUIER autenticado podía reescribirlo. Se deniega toda
    // escritura de cliente; ver advertencia sobre ejecutarDistribucionAction
    // en el encabezado del archivo (probar antes de confiar en esto).
    // ─────────────────────────────────────────────────────────────────
    match /distribuciones/{distribucionId} {
      // Nota: el lenguaje de reglas de Firestore no tiene `.map()`/lambdas
      // reales, así que no se puede filtrar `distribucionPorSocio` por
      // usuarioId acá dentro. Cada socio ya ve su propio resultado
      // (gananciaReal, roiReal) en su documento de `inversiones`, que sí
      // tiene lectura por dueño — no hace falta duplicar el acceso acá.
      allow read: if signedIn() && (resource.data.gestorId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────
    // PUENTE ODOO ↔ FIREBASE (journal de idempotencia)
    // ─────────────────────────────────────────────────────────────────
    // SOLO SERVIDOR (Admin SDK): el usuario unicamente puede LEER sus propios
    // registros. Antes podia crearlos (y actualizar los de retiros) desde el
    // navegador; con `amount` editable en un retiro 'pending', la recuperacion
    // de retiros habria acreditado en Odoo un monto elegido por el usuario.
    match /plataforma_cargas/{transactionId} {
      allow read: if signedIn() && resource.data.firebase_uid == request.auth.uid || isAdmin();
      allow write: if false;
    }

    match /plataforma_retiros/{transactionId} {
      allow read: if signedIn() && resource.data.firebase_uid == request.auth.uid || isAdmin();
      allow write: if false;
    }

    match /plataforma_transferencias/{transferenciaId} {
      allow read: if signedIn() && (resource.data.origen_uid == request.auth.uid
        || resource.data.destino_uid == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────
    match /reconciliation_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /hitos/{hitoId} {
      allow read: if signedIn();
      allow write: if esGestorDelProyecto(resource.data.proyectoId)
        || (request.resource.data.proyectoId is string && esGestorDelProyecto(request.resource.data.proyectoId));
    }

    match /documentos/{documentoId} {
      allow read: if signedIn();
      allow write: if esGestorDelProyecto(resource.data.proyectoId)
        || (request.resource.data.proyectoId is string && esGestorDelProyecto(request.resource.data.proyectoId));
    }

    // ─────────────────────────────────────────────────────────────────
    // DENEGAR TODO LO DEMÁS POR DEFECTO
    // Hoy: `allow read, write: if request.auth != null` para cualquier
    // colección no listada — cualquier cuenta autenticada podía leer/
    // escribir CUALQUIER cosa en colecciones nuevas o no contempladas.
    // ─────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
